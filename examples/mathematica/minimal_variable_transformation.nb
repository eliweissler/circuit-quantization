Notebook[{

Cell[CellGroupData[{
Cell["Minimal circuit variable transformation", "Title",ExpressionUUID->"eb1d8f9e-4f96-4de6-a2fd-ba99e94e1eca"],

Cell[CellGroupData[{

Cell["General functions", "Section",ExpressionUUID->"4628a889-205b-40ce-b9fb-110cd3dae22e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "CircuitIncidenceMatrix", ",", "BranchMatrix", ",", 
    "IrrotationalAssignment", ",", "ClassicalOffsetCharge"}], "]"}], ";", 
  RowBox[{
   RowBox[{"CircuitIncidenceMatrix", "[", 
    RowBox[{"edges_List", ",", "nodes_List"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Boole", "[", 
       RowBox[{
        RowBox[{
        "nodes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "===", 
        RowBox[{"edges", "\[LeftDoubleBracket]", 
         RowBox[{"j", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], "-", 
      RowBox[{"Boole", "[", 
       RowBox[{
        RowBox[{
        "nodes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "===", 
        RowBox[{"edges", "\[LeftDoubleBracket]", 
         RowBox[{"j", ",", "2"}], "\[RightDoubleBracket]"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "nodes", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"BranchMatrix", "[", 
    RowBox[{"w_", ",", "values_List"}], "]"}], ":=", 
   RowBox[{"w", ".", 
    RowBox[{"DiagonalMatrix", "[", "values", "]"}], ".", 
    RowBox[{"Transpose", "[", "w", "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"IrrotationalAssignment", "[", 
    RowBox[{"g_", ",", "oi_", ",", "cb_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ct", ",", "gp", ",", "p"}], "}"}], ",", 
     RowBox[{
      RowBox[{"ct", "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "z", "]"}], ".", "oi", ".", "cb", ".", 
        RowBox[{"Transpose", "[", "oi", "]"}], ".", "z"}]}], ";", 
      RowBox[{"gp", "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "g", "]"}], ".", 
        RowBox[{"Inverse", "[", 
         RowBox[{"g", ".", 
          RowBox[{"Transpose", "[", "g", "]"}]}], "]"}]}]}], ";", 
      RowBox[{"p", "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "oi", "]"}], ".", "z", ".", 
        RowBox[{"Inverse", "[", "ct", "]"}], ".", 
        RowBox[{"Transpose", "[", "z", "]"}], ".", "oi", ".", "cb"}]}], ";", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "cb", "]"}], "]"}], "-", "p"}], ")"}], ".", 
        "gp"}], "]"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"ClassicalOffsetCharge", "[", 
    RowBox[{
    "cs_", ",", "v_", ",", "oi_", ",", "cb_", ",", "b_", ",", "fe_", ",", 
     "time_"}], "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"cs", ".", "v"}]}], "+", 
     RowBox[{"oi", ".", "cb", ".", "b", ".", 
      RowBox[{
       SubscriptBox["\[PartialD]", "time"], "fe"}]}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[440]:=",ExpressionUUID->"7429adeb-29e9-466b-b485-0fab4afeefe5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Circuit topology and incidence matrices", "Section",ExpressionUUID->"c1d2d32a-1ccd-4d8e-9cd0-49ec42c63193"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nodes", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "4"}], "]"}]}], ";", 
  RowBox[{"internalNodes", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]}], ";", 
  RowBox[{"groundNode", "=", "4"}], ";", 
  RowBox[{"edges", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], ";", 
  RowBox[{"\[CapitalOmega]", "=", 
   RowBox[{"CircuitIncidenceMatrix", "[", 
    RowBox[{"edges", ",", "nodes"}], "]"}]}], ";", 
  RowBox[{"internalRows", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"FirstPosition", "[", 
        RowBox[{"nodes", ",", "#1"}], "]"}], "&"}], ")"}], "/@", 
     "internalNodes"}], "]"}]}], ";", 
  RowBox[{"\[CapitalOmega]i", "=", 
   RowBox[{"\[CapitalOmega]", "\[LeftDoubleBracket]", 
    RowBox[{"internalRows", ",", "All"}], "\[RightDoubleBracket]"}]}], ";", 
  RowBox[{"jBranches", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "4", ",", "6"}], "}"}]}], ";", 
  RowBox[{"lBranches", "=", 
   RowBox[{"{", 
    RowBox[{"3", ",", "5", ",", "7"}], "}"}]}], ";", 
  RowBox[{"\[CapitalOmega]J", "=", 
   RowBox[{"\[CapitalOmega]i", "\[LeftDoubleBracket]", 
    RowBox[{"All", ",", "jBranches"}], "\[RightDoubleBracket]"}]}], ";", 
  RowBox[{"\[CapitalOmega]L", "=", 
   RowBox[{"\[CapitalOmega]i", "\[LeftDoubleBracket]", 
    RowBox[{"All", ",", "lBranches"}], "\[RightDoubleBracket]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[CapitalOmega]", " ", "//", "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.9967631332776127`*^9, 3.996763144054757*^9}},
 CellLabel->
  "In[441]:=",ExpressionUUID->"c4c7cd1d-38ed-42d5-a2df-4221fae489ed"],

