Cell["5. Flux dependence and classical coupling", "Section",ExpressionUUID->"648505d5-098b-4518-ab87-db1a364dffc6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Phi]v", "=", 
   RowBox[{"{", 
    RowBox[{
    "\[Phi]", ",", "\[Phi]F", ",", "\[Phi]\[CapitalSigma]", ",", 
     "\[Phi]\[CapitalDelta]"}], "}"}]}], ";", 
  RowBox[{"\[CapitalPhi]e", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalPhi]K", "[", "t", "]"}], ",", 
     RowBox[{"\[CapitalPhi]F", "[", "t", "]"}], ",", "0"}], "}"}]}], ";", 
  RowBox[{"\[CapitalPhi]b", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Transpose", "[", "\[CapitalOmega]i", "]"}], ".", "Z", ".", 
      "\[Phi]v"}], "+", 
     RowBox[{"B", ".", "\[CapitalPhi]e"}]}], "]"}]}], ";", 
  RowBox[{"\[CapitalPhi]J", "=", 
   RowBox[{
   "\[CapitalPhi]b", "\[LeftDoubleBracket]", "jBranches", 
    "\[RightDoubleBracket]"}]}], ";", 
  RowBox[{"\[CapitalPhi]L", "=", 
   RowBox[{
   "\[CapitalPhi]b", "\[LeftDoubleBracket]", "lBranches", 
    "\[RightDoubleBracket]"}]}], ";", 
  RowBox[{"Uj", "=", 
   RowBox[{"-", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"EJL", ",", "EJR", ",", "EJf"}], "}"}], " ", 
      RowBox[{"Cos", "[", 
       FractionBox["\[CapitalPhi]J", "\[Phi]0"], "]"}]}], "]"}]}]}], ";", 
  RowBox[{"Ul", "=", 
   RowBox[{"Simplify", "[", 
    FractionBox[
     RowBox[{"\[CapitalPhi]L", ".", "LbInv", ".", "\[CapitalPhi]L"}], "2"], 
    "]"}]}], ";", 
  RowBox[{"Csrc", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"-", "Cg"}], "}"}], ",", 
     RowBox[{"{", "0", "}"}], ",", 
     RowBox[{"{", "0", "}"}], ",", 
     RowBox[{"{", "0", "}"}]}], "}"}]}], ";", 
  RowBox[{"v", "=", 
   RowBox[{"{", 
    RowBox[{"Vg", "[", "t", "]"}], "}"}]}], ";", 
  RowBox[{"Qgn", "=", 
   RowBox[{"ClassicalOffsetCharge", "[", 
    RowBox[{
    "Csrc", ",", "v", ",", "\[CapitalOmega]i", ",", "Cb", ",", "B", ",", 
     "\[CapitalPhi]e", ",", "t"}], "]"}]}], ";", 
  RowBox[{"Qg", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", "Z", "]"}], ".", "Qgn"}], "]"}]}], ";", 
  RowBox[{"qv", "=", 
   RowBox[{"{", 
    RowBox[{
    "q0", ",", "qF", ",", "q\[CapitalSigma]", ",", "q\[CapitalDelta]"}], 
    "}"}]}], ";", 
  RowBox[{"H", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"qv", "-", "Qg"}], ")"}], ".", "CtInv", ".", 
      RowBox[{"(", 
       RowBox[{"qv", "-", "Qg"}], ")"}]}]}], "+", "Ul", "+", 
    "Uj"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"H", " ", "//", "Expand"}]}], "Input",
 CellChangeTimes->{{3.9967633553276787`*^9, 3.996763356925159*^9}, {
