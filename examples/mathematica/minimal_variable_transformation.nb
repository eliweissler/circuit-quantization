Cell["2. Symbolic element matrices", "Section",ExpressionUUID->"824ded83-93cd-4868-90c5-0c0dfb43a532"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Cb", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
     "Csh", ",", "CJL", ",", "0", ",", "CJR", ",", "0", ",", "CJf", ",", 
      "0"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LbInv", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["1", "LkL"], ",", 
      FractionBox["1", "LkR"], ",", 
      FractionBox["1", "Lf"]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ci", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"\[CapitalOmega]i", ".", "Cb", ".", 
     RowBox[{"Transpose", "[", "\[CapitalOmega]i", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Li", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"\[CapitalOmega]L", ".", "LbInv", ".", 
     RowBox[{"Transpose", "[", "\[CapitalOmega]L", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Ci", " ", "//", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{"Li", " ", "//", "MatrixForm"}]}], "Input",
